# EPGS environment variable reference.
#
# Copy this file to `.env` at the repo root and fill in real values for
# local development. NEVER commit a real `.env` file - it is gitignored
# on purpose. ALL secrets must come from environment variables only,
# never hardcoded in source. See README.md "Environment variables".
#
# Note: apps/api and apps/worker each read PORT from their own process
# environment. When running them together (see root `pnpm dev`), each
# app's start script sets its own PORT so they don't collide - see
# apps/api/.env.example and apps/worker/.env.example for per-app values.

# ---- Shared across api / worker ------------------------------------------
NODE_ENV=development
TZ=Asia/Shanghai
LOG_LEVEL=log

# PostgreSQL connection string used by apps/api and apps/worker (via Prisma).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Matches docker-compose.yml's local Postgres service by default.
DATABASE_URL=postgresql://epgs:epgs@localhost:5432/epgs

# ---- apps/api --------------------------------------------------------------
PORT=3000

# ---- apps/worker -------------------------------------------------------------
# Worker listens on its own port for internal health checks (not
# publicly exposed). Must differ from apps/api's PORT when run together.
# Incremental PACS/RIS sync job cadence (issue #6, see apps/worker/src/sync).
# Default 3, must be 1-5 minutes per the issue's acceptance criteria.
SYNC_INTERVAL_MINUTES=3
# apps/api also reads this (read-only) to judge sync-status staleness -
# see GET /api/system/sync-status. Keep both apps' values in sync.
SYNC_PAGE_SIZE=200
SYNC_LOOKBACK_MINUTES=10
# First-ever run window (minutes) when there's no prior successful sync
# yet - independent from SYNC_LOOKBACK_MINUTES, see apps/worker/.env.example.
SYNC_FIRST_RUN_LOOKBACK_MINUTES=1440
SYNC_MAX_RETRIES=5
SYNC_RETRY_BASE_DELAY_MS=1000

# PACS/RIS read-only adapter. This repository never connects to the hospital
# source database: production calls the separately deployed REST gateway.
# 'csv' = local-only API-shaped Mock CSV; 'http' = production REST gateway.
PACS_ADAPTER_MODE=csv
# Convert the hospital's raw export first (pnpm --filter worker run mock:convert),
# which writes Doc/moke-data.utf8.csv from Doc/moke-*.csv (issue #42).
PACS_MOCK_CSV_PATH=Doc/moke-data.utf8.csv
# PACS_HTTP_BASE_URL=
# PACS_HTTP_SERVICE_TOKEN=
PACS_HTTP_TIMEOUT_MS=10000

# ---- apps/web ----------------------------------------------------------------
# Vite only exposes vars prefixed with VITE_ to client-side code.
VITE_API_BASE_URL=http://localhost:3000

# ---- Local authentication (apps/api, issue #31) -------------------------------
# Replace this example with at least 32 random characters in every environment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_SECONDS=28800
WEB_ORIGIN=http://localhost:5173

# ---- Notification module (apps/api, issue #53) ---------------------------------
# Encryption key for NotificationChannel.webhookUrlCiphertext (the WeCom
# webhook URL - the first reversible secret this schema stores). Replace
# with at least 32 random characters in every environment, independent of
# JWT_SECRET (e.g. `openssl rand -base64 32`).
NOTIFICATION_SECRET_KEY=replace-with-at-least-32-random-characters

# Issue #54: display name substituted for the {{hospitalName}} placeholder
# when rendering notification templates. Defaults to 菏泽市中医医院 when
# unset - only set this if the deployment is a different hospital.
# HOSPITAL_NAME=菏泽市中医医院
