# apps/api local environment. Copy to apps/api/.env for local dev.
# See root .env.example for the full variable reference/comments.
NODE_ENV=development
PORT=3000
TZ=Asia/Shanghai
LOG_LEVEL=log
DATABASE_URL=postgresql://epgs:epgs@localhost:5432/epgs

# Issue #6: used only by GET /api/system/sync-status to judge how stale
# a sync run is (as a multiple of this interval). Should match
# apps/worker's SYNC_INTERVAL_MINUTES - a mismatch only affects health
# classification accuracy, not correctness of the raw data returned.
SYNC_INTERVAL_MINUTES=3
