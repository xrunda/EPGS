// EPGS Prisma schema.
//
// Monitoring business data model for issue #3, converged to a READ-ONLY
// DISPLAY model by issue #26. Decoupled from PACS/RIS: this schema only
// stores what EPGS itself needs to keep monitoring results displayable
// after the browser closes (rules, matches, current highest level, the
// read-only patient/study snapshot, and sync job bookkeeping). It does
// NOT store or duplicate PACS/RIS image data, and it does NOT implement
// the keyword-matching algorithm (issue #5) or any HTTP API
// (issue #4/#7/#8) - those consume this schema via Prisma Client in
// later issues.
//
// Per issue #26 there is NO closed-loop reporting/disposition model here:
// no reporting / acknowledgment / handling / false-positive actions, no
// status columns, no monitor_action table. Red/yellow/green levels are
// display markers only - they affect color/sort/filter, nothing else.
//
// Field-level meaning, sensitivity classification and retention guidance
// live in /docs/data-dictionary.md - read that alongside this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// app_user - lightweight local accounts for the hospital intranet
// ---------------------------------------------------------------------------

model AppUser {
  id String @id @default(uuid()) @db.Uuid

  username        String  @unique @db.VarChar(50)
  displayName     String  @map("display_name") @db.VarChar(100)
  passwordHash    String  @map("password_hash") @db.VarChar(255)
  passwordVersion Int     @default(1) @map("password_version")
  isActive        Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_user")
}

// ---------------------------------------------------------------------------
// app_user_access - authorization grants for app_user accounts (issue #13)
// ---------------------------------------------------------------------------

/// Authorization grants for one local account, keyed by the exact username
/// in app_user (NOT an FK - deliberately decoupled so access can be assigned
/// independently of the account lifecycle in issue #31). There is no row
/// unless an operator has explicitly assigned one via `auth:assign-access`:
/// an account with no row is authenticated (issue #31) but has no roles, so
/// role-gated endpoints return 403 (fail-closed). roles/departmentScope are
/// stored as denormalized arrays and replaced wholesale on each assignment.
model AppUserAccess {
  /// Exact username from app_user.username (decoupled, not an FK).
  username String @id @db.VarChar(100)

  /// Roles granted to this user. Empty array = no roles = no role-gated access.
  roles AppRole[]

  /// Departments this user may see. Empty array = all departments. Values
  /// must exactly match monitor_record.department strings (case-sensitive);
  /// a mismatch silently yields an empty result set - see docs/auth.md.
  departmentScope String[] @map("department_scope")

  /// Whether this user may see unmasked HIGH-sensitivity patient detail
  /// (patientName/reportContent/diagnosis/bedNo). False = masked responses
  /// for all roles, including SYSTEM_ADMIN.
  patientDetail Boolean @default(false) @map("patient_detail")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_user_access")
}

// ---------------------------------------------------------------------------
// audit_log - tamper-resistant-ish read audit trail (issue #13)
// ---------------------------------------------------------------------------

/// One audited operation. Written by AuditService for key reads and rules
/// writes; the meta column carries only LOW-sensitivity context and must
/// NEVER contain patient data, report body text, or credentials (the
/// log-sanitization spec enforces this). Rows are append-only from the API's
/// perspective - there is no update/delete endpoint, only AUDITOR-gated read.
model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  /// Username of the acting account (app_user.username). Nullable so the
  /// service can skip writing when no authenticated identity is available.
  actorUsername String? @map("actor_username") @db.VarChar(100)

  /// Primary role of the actor at time of the action (see pickPrimaryRole).
  actorRole AppRole @map("actor_role")

  action AuditAction

  /// High-level resource type, e.g. monitor_record / monitor_rule / audit_log.
  resourceType String @map("resource_type") @db.VarChar(100)

  /// Resource identifier when applicable (e.g. monitor_record.id, rule id).
  resourceId String? @map("resource_id") @db.Uuid

  /// Department context (record's department / filter value) when applicable.
  department String? @db.VarChar(100)

  /// LOW-sensitivity audit context (filters, counts, masked flag, rule
  /// semantics). Must never contain patient data / report text / secrets.
  meta Json?

  /// Best-effort client IP (see docs/auth.md for reverse-proxy caveats).
  ip String? @db.VarChar(64)

  /// Request correlation id for joining against API error logs.
  correlationId String? @map("correlation_id") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([action, createdAt])
  @@index([actorUsername, createdAt])
  @@index([department, createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Attention level assigned to a monitor_record / monitor_match. Fixed set
/// per issue #3 acceptance criteria - do not add values without a migration
/// review, since downstream UI color-codes on this exact enum.
enum MonitorLevel {
  RED
  YELLOW
  GREEN
  UNCLASSIFIED
}

/// Which field the keyword match (or rule) applies to. Kept intentionally
/// generic/coarse - issue #5 owns the actual matching algorithm and may
/// interpret these values more granularly at runtime.
enum MatchField {
  FINDINGS
  IMPRESSION
  REPORT_TEXT
  STUDY_DESCRIPTION
  OTHER
}

/// How a monitor_rule keyword is matched against report text.
enum MatchMode {
  EXACT
  CONTAINS
  REGEX
}

/// Issue #87: what the AI semantic judge concluded about the LOCAL CONTEXT a
/// keyword hit sits in. This is a statement about the report text only - it is
/// NOT a clinical judgement and NOT a monitor level. The monitor level
/// (monitor_match.level / monitor_record.current_level) continues to come from
/// the deterministic keyword rule and is never set by the model.
///   PRESENT   本次明确存在          -> keep the keyword hit
///   NEGATED   明确否定              -> filterable only at HIGH confidence
///   SUSPECTED 疑似/考虑/不能除外    -> keep
///   HISTORY   仅为既往史/背景描述   -> filterable only at HIGH confidence AND
///                                     when the rule's semanticIntent
///                                     explicitly excludes history
///   UNCERTAIN 无法可靠判断          -> keep
/// NULL on monitor_match means "no verdict yet" - see semanticResolvedAt.
enum SemanticStatus {
  PRESENT
  NEGATED
  SUSPECTED
  HISTORY
  UNCERTAIN
}

/// Issue #87: the model's self-reported confidence in `semantic_status`.
/// Only HIGH ever authorizes filtering (see the disposition matrix in
/// packages/ai-semantic/src/decision.ts) - MEDIUM/LOW always keep the
/// original keyword hit, so a hedged model can never silently drop a hit.
enum SemanticConfidence {
  HIGH
  MEDIUM
  LOW
}

/// Issue #87: outcome of ONE AI semantic judge attempt, i.e. the audit verdict
/// on the CALL itself rather than on the report text.
///   OK    模型返回了 schema 合法、evidence 可回指原文的结果
///   ERROR 超时/网络/非法 JSON/schema 失败/未知枚举等任何失败 - always
///         fail-open to the original keyword result
/// A "skipped" case (rule has no semanticIntent, or the judge is disabled)
/// deliberately writes NO audit row - no model call means no AI decision to
/// audit, and "why wasn't this judged" is deterministically answerable from
/// monitor_rule.semantic_intent IS NULL. Such matches are still marked
/// resolved so the queue drains (see MonitorMatch.semanticResolvedAt).
enum SemanticJudgeOutcome {
  OK
  ERROR
}

/// Issue #87: which AI task produced an audit row. VALIDATE_MATCH is the only
/// value implemented today. Issue #88's "Classify Report" task will add its own
/// value (and its own table shape) when it lands - do not add values here
/// without that task's implementation and tests.
enum SemanticTask {
  VALIDATE_MATCH
}

/// Outcome status of one sync_job_log run.
enum SyncJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

/// Application role assigned to a user via app_user_access (issue #13).
/// Authorization is layered on top of issue #31's local-account JWT login.
/// VIEWER - read-only workbench, scoped to the user's departments.
/// RULE_ADMIN - manages monitor_rule keywords (still subject to data masking).
/// SYSTEM_ADMIN - system operator; by default has NO patient detail rights.
/// AUDITOR - read-only access to the audit log.
/// USER_ADMIN - manages app_user accounts and app_user_access grants via the
/// user-admin feature (issue #78); deliberately separate from SYSTEM_ADMIN so
/// account/authorization management is not bundled with system-status access.
enum AppRole {
  VIEWER
  RULE_ADMIN
  SYSTEM_ADMIN
  AUDITOR
  USER_ADMIN
}

/// One audited operation. LOGIN is a reserved seam for issue #31 and has no
/// trigger point yet - do not add values without a migration + audit-contract
/// review. CONFIG_CHANGE now has a real trigger point: notification channel/
/// template writes (issue #54). NOTIFICATION_TEST_SEND (issue #52/#54) is a
/// distinct action from CONFIG_CHANGE because a test-send is a real outbound
/// push, not a configuration edit, and must be independently auditable.
enum AuditAction {
  EXAM_LIST
  EXAM_DETAIL
  RULE_CREATE
  RULE_UPDATE
  RULE_IMPORT
  CONFIG_CHANGE
  AUDIT_VIEW
  LOGIN
  NOTIFICATION_TEST_SEND
  /// Manual "run now" of a notification rule (issue: push rules). The
  /// scheduled (SCHEDULED) path has no human operator and is audited by the
  /// push_log table itself; only the manual trigger is a real outbound
  /// action by a person that needs an audit_log entry.
  NOTIFICATION_RULE_RUN
  /// User-admin actions (issue #78/#79): account and access-grant writes
  /// made through the new /api/users endpoints. Mirrors the existing manual
  /// audit.record(...) call pattern used by RULE_CREATE/RULE_UPDATE - no
  /// decorator/interceptor magic.
  USER_CREATE
  USER_ROLE_CHANGE
  USER_DISABLE
  USER_ENABLE
  USER_DELETE
  USER_PASSWORD_RESET
}

/// Message shape for a notification_template. Deliberately mirrors what the
/// WeCom (企业微信) group-robot webhook accepts today: `TEXT` -> `msgtype:
/// markdown`, `NEWS` -> `msgtype: news` (single-article image/title/summary/link
/// card). See docs/notification-design.md §2/§9 - richer types (WeCom
/// textcard / template_card) require the self-built-app message API instead
/// of the webhook, which is out of scope until the "企业可信IP" circular
/// dependency described there is resolved. Do not add values without
/// confirming the corresponding send-path implementation exists.
enum NotificationMsgType {
  TEXT
  NEWS
}

/// Why a push_log row was created: the daily scheduler (SCHEDULED) or the
/// manual "run now" button (MANUAL). Only SCHEDULED rows are subject to the
/// per-rule-per-day idempotency index (see PushLog).
enum NotificationPushTrigger {
  SCHEDULED
  MANUAL
}

/// Aggregate outcome of a push_log run across ALL of the rule's channels
/// (SUCCESS = every delivery succeeded, PARTIAL = at least one succeeded and
/// one failed, FAILED = every delivery failed).
enum NotificationPushStatus {
  SUCCESS
  PARTIAL
  FAILED
}

/// Per-channel outcome of one delivery inside a push_log.
enum NotificationPushDeliveryStatus {
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------------
// monitor_rule - keyword rule definitions (versioned, soft-disable only)
// ---------------------------------------------------------------------------

/// A single keyword rule used by the (out-of-scope, issue #5) matching
/// engine to classify report text into a MonitorLevel. Rules are versioned
/// and soft-disabled (isEnabled) rather than deleted, so historical
/// monitor_match rows keep a stable, auditable reference to the exact rule
/// version that produced them.
model MonitorRule {
  id String @id @default(uuid()) @db.Uuid

  /// The keyword or phrase to match. Combined with matchMode to decide how.
  keyword String @db.VarChar(255)

  /// Attention level this rule assigns when it matches.
  level MonitorLevel

  /// Which report field(s) this rule is evaluated against.
  matchField MatchField @map("match_field")

  /// How the keyword is compared against report text.
  matchMode MatchMode @default(CONTAINS) @map("match_mode")

  /// Issue #87: the doctor's own words for "what this keyword is meant to
  /// catch", e.g. "本次检查明确发现或疑似存在溃疡性病变；明确否定、单纯既往史
  /// 不作为本次有效命中。" Read by the AI semantic judge (Validate Match task)
  /// as the intent it validates a hit against - it NEVER changes keyword
  /// matching itself.
  ///
  /// NULL/empty means "not configured": such rules are skipped by the judge
  /// entirely (no model call), so a rule without an intent behaves exactly
  /// like it did before #87.
  ///
  /// Included in the versioned-edit set (see rules.service.ts
  /// SEMANTIC_FIELDS): editing it creates a NEW MonitorRule row and disables
  /// the old one, so a historical monitor_match row keeps pointing at the
  /// exact intent text that was in force when the AI judged it. Editing it in
  /// place would retroactively rewrite what past judgments appear to have
  /// used - which is exactly what the audit trail must not allow.
  semanticIntent String? @map("semantic_intent") @db.Text

  /// Optional grouping label, e.g. department or tumor-site category, for
  /// workbench filtering and rule-set curation. Free text, not an FK.
  category String? @db.VarChar(100)

  /// Soft enable/disable switch. Disabled rules are excluded from new
  /// matching runs but historical monitor_match rows referencing this rule
  /// are never deleted or reassigned.
  isEnabled Boolean @default(true) @map("is_enabled")

  /// Monotonically increasing version for this logical rule. A rule edit
  /// that changes matching semantics (keyword/level/matchField/matchMode)
  /// should be modeled as a new MonitorRule row with version = previous + 1
  /// and the same ruleGroupId, so existing monitor_match rows keep
  /// pointing at the exact version that matched. See data dictionary.
  version Int @default(1)

  /// Stable identifier shared by all versions of the "same" logical rule.
  /// Defaults to this row's own id when a rule is first created (i.e. the
  /// first version is its own group anchor).
  ruleGroupId String @map("rule_group_id") @db.Uuid

  /// Free-text rationale / clinical justification, for audit review.
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Operator account (external identity, e.g. HIS/OA user id) who created
  /// this rule version. Not a FK - user/auth store is owned by a later
  /// issue; kept as an opaque string to avoid a premature cross-schema
  /// dependency.
  createdBy String @map("created_by") @db.VarChar(100)

  /// Operator account who last modified this rule version.
  updatedBy String @map("updated_by") @db.VarChar(100)

  matches MonitorMatch[]

  @@index([level, isEnabled])
  @@index([ruleGroupId])
  @@index([category])
  @@map("monitor_rule")
}

// ---------------------------------------------------------------------------
// monitor_record - one row per monitored study/report, with current state
// ---------------------------------------------------------------------------

/// One monitored study/report from the source PACS/RIS system, deduplicated
/// on the source's stable record ID. READ-ONLY DISPLAY row (issue #26):
/// it holds the snapshotted source fields, the current attention level and
/// hit timing, while full match evidence lives in monitor_match. There is
/// NO disposition/status lifecycle - level only affects display
/// color/sort/filter.
///
/// Idempotency: re-syncing the same source record/report/version must not
/// create a duplicate row - see the @@unique constraint below, which sync
/// jobs (issue #6/#8) must upsert against. reportId/reportVersion/
/// sourceUpdatedAt are internal sync bookkeeping, not displayed.
model MonitorRecord {
  id String @id @default(uuid()) @db.Uuid

  // --- Source identity (natural key from PACS/RIS, read-only adapter) ----

  /// Source system's stable record ID (来源稳定 ID). Primary half of the
  /// natural key used for idempotent upserts from the read-only adapter.
  sourceRecordId String @map("source_record_id") @db.VarChar(64)

  /// Source system's report identifier. Second half of the natural key -
  /// a study can have zero, one, or (after amendment) multiple reports
  /// over time, each producing its own logical monitor_record. Internal
  /// sync bookkeeping (not displayed).
  reportId String @map("report_id") @db.VarChar(64)

  /// Report version/revision number from the source system (e.g.
  /// incremented on amendment). Used together with sourceUpdatedAt to
  /// detect whether a re-synced report actually changed and needs
  /// re-matching, without creating a duplicate monitor_record. Internal
  /// sync bookkeeping (not displayed).
  reportVersion Int @default(1) @map("report_version")

  /// Last-modified timestamp of the report as reported by the source
  /// system (not EPGS's own updatedAt). Used for idempotency / staleness
  /// checks alongside reportVersion. Internal sync bookkeeping (not
  /// displayed).
  sourceUpdatedAt DateTime @map("source_updated_at") @db.Timestamptz(6)

  // --- Patient / study snapshot (read-only display, source of truth = RIS)
  // Snapshotted (not FK'd) because PACS/RIS is the system of record and
  // EPGS must keep displaying results even if the source record later
  // changes or the patient is not resolvable. See data dictionary for
  // sensitivity levels and the "minimum necessary for display" rule.

  /// Patient display name snapshot. HIGH sensitivity - see data dictionary.
  patientName String? @map("patient_name") @db.VarChar(100)

  /// Ordering/performing department at time of sync. Used for workbench
  /// filtering.
  department String? @db.VarChar(100)

  /// Current bed number (PAADM_CurrentBed_DR->BED_Code). Empty for
  /// outpatient/unknown -> display as "—".
  bedNo String? @map("bed_no") @db.VarChar(50)

  /// Patient type code from the source (PAADM_Type raw value, e.g. I/O).
  patientTypeCode String? @map("patient_type_code") @db.VarChar(20)

  /// Confirmed Chinese meaning of patientTypeCode (住院/门诊/…). NULL until
  /// the hospital dictionary confirms the mapping - unknown values must not
  /// be guessed.
  patientTypeName String? @map("patient_type_name") @db.VarChar(50)

  /// Exam/study item snapshot (e.g. "电子胃镜检查"), for display and filter.
  examItem String? @map("exam_item") @db.VarChar(255)

  /// Date/time the exam was performed, per source system.
  examTime DateTime? @map("exam_time") @db.Timestamptz(6)

  // --- Aggregate monitoring state (denormalized for fast workbench reads) -

  /// Highest MonitorLevel across all current monitor_match rows for this
  /// record. Denormalized/maintained by the matching engine (issue #5) so
  /// the workbench can filter/sort without joining monitor_match. A display
  /// marker only - affects color/sort/filter, no business action (issue
  /// #26).
  currentLevel MonitorLevel @default(UNCLASSIFIED) @map("current_level")

  /// First time any rule matched this record.
  firstMatchedAt DateTime? @map("first_matched_at") @db.Timestamptz(6)

  /// Most recent time any rule matched this record (including re-matches
  /// after a report amendment).
  lastMatchedAt DateTime? @map("last_matched_at") @db.Timestamptz(6)

  // --- Report content snapshot (read-only display) ------------------------

  /// Full report findings/body text (RISR_ExamDesc 原文). Read-only display
  /// snapshot; empty -> show placeholder, never hide the row.
  reportContent String? @map("report_content") @db.Text

  /// Diagnosis text (RISR_DiagDesc 原文). Read-only display snapshot.
  diagnosis String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  matches MonitorMatch[]

  /// Idempotency guard: the same source record/report/version must never
  /// produce two rows. Sync jobs upsert on this key.
  @@unique([sourceRecordId, reportId, reportVersion], name: "uq_monitor_record_source_version")
  @@index([currentLevel])
  @@index([department])
  @@index([patientTypeCode])
  @@index([examTime])
  @@index([lastMatchedAt])
  @@index([sourceRecordId, reportId])
  @@map("monitor_record")
}

// ---------------------------------------------------------------------------
// monitor_match - full hit evidence (many per record, never overwritten)
// ---------------------------------------------------------------------------

/// One keyword hit: a specific MonitorRule matching a specific
/// MonitorRecord's report text. Multiple matches accumulate per record so
/// the "current highest level" (on MonitorRecord) and "all hit evidence"
/// (here) are both retained, per issue #3 acceptance criteria.
///
/// Idempotency: re-matching the same report version must not duplicate a
/// previously recorded hit - see the @@unique constraint below.
///
/// NOTE (issue #87): the judge's queue index is a hand-written PARTIAL index
/// `uq_monitor_match_semantic_queue` ON (semantic_claimed_at, id) WHERE
/// semantic_resolved_at IS NULL - Prisma @@index cannot express a WHERE
/// clause, so it is NOT representable here. If `prisma migrate dev` ever
/// proposes dropping it as drift, re-apply it by hand (same caveat as
/// PushLog's uq_push_log_scheduled_dedup).
model MonitorMatch {
  id String @id @default(uuid()) @db.Uuid

  monitorRecordId String        @map("monitor_record_id") @db.Uuid
  record          MonitorRecord @relation(fields: [monitorRecordId], references: [id], onDelete: Cascade)

  ruleId String      @map("rule_id") @db.Uuid
  rule   MonitorRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  /// Denormalized copy of the keyword text at match time, kept even if the
  /// rule is later edited/versioned, so this row remains a faithful,
  /// immutable record of what actually matched.
  keyword String @db.VarChar(255)

  /// Denormalized copy of the level assigned at match time.
  level MonitorLevel

  /// Which report field the hit occurred in.
  matchedField MatchField @map("matched_field")

  /// Short surrounding-text snippet for display in the evidence panel.
  /// Deliberately bounded/short (not the full report) - see data
  /// dictionary retention policy for why full report text is a separate,
  /// explicitly-gated cache field on MonitorRecord instead.
  contextSnippet String @map("context_snippet") @db.VarChar(500)

  /// Report version this match was produced against - lets a record with
  /// multiple report versions (amendments) keep each version's matches
  /// distinguishable, and is part of the idempotency key.
  reportVersion Int @map("report_version")

  matchedAt DateTime @default(now()) @map("matched_at") @db.Timestamptz(6)

  // --- Issue #87: AI semantic judgement of THIS hit ------------------------
  //
  // These columns are ADDITIVE. The keyword evidence above (keyword / level /
  // matchedField / contextSnippet / matchedAt) is the immutable record of what
  // the DETERMINISTIC engine found and is never rewritten by the AI path. The
  // AI judgement lives in its own audit table (MonitorMatchSemantic, one row
  // per attempt); the columns below are only the CURRENT verdict denormalized
  // onto the match so that (a) the effective-level query is a single indexed
  // GROUP BY and (b) the workbench detail can show the verdict without a join.
  //
  // SEMANTICS ARE INTENTIONALLY ONE-SIDED: `semanticFiltered` may only ever be
  // set to true by packages/ai-semantic's decision matrix (NEGATED+HIGH, or
  // HISTORY+HIGH with an intent that excludes history). Every failure mode -
  // model error, timeout, unparseable output, unverifiable evidence, LOW/
  // MEDIUM confidence, unknown enum, judge disabled - leaves it at its default
  // `false`, i.e. the original keyword hit stands. There is no code path that
  // can turn a failure into a filter.

  /// Anchor occurrence this judgement was made on: start offset (inclusive,
  /// UTF-16 code unit index) into the ORIGINAL field text identified by
  /// matchedField. NULL for rows written before #87 (or when matching produced
  /// no usable offset) - the judge then re-derives occurrences from the rule +
  /// report text instead. Note the row is per (record, rule, field, version),
  /// so a keyword occurring several times keeps only ONE row (see the dedup
  /// constraint below); sibling occurrences are re-derived and folded into the
  /// same context window rather than being stored here.
  matchStart Int? @map("match_start")

  /// Exclusive end offset of the anchor occurrence (see matchStart).
  matchEnd Int? @map("match_end")

  /// Latest model verdict (NULL = not judged yet, or a rule with no
  /// semanticIntent). Denormalized from the newest OK MonitorMatchSemantic row.
  semanticStatus SemanticStatus? @map("semantic_status")

  /// Latest model confidence, denormalized alongside semanticStatus.
  semanticConfidence SemanticConfidence? @map("semantic_confidence")

  /// The DECISION, not the model's opinion: true = this hit must not count as
  /// an effective attention result (excluded from monitor_record.current_level
  /// and from every effective-hit read path). Only ever set by deterministic
  /// code. Default false = the original keyword hit stands.
  semanticFiltered Boolean @default(false) @map("semantic_filtered")

  /// When this match's semantic judgement reached a TERMINAL state and left the
  /// judge queue. Set for OK, ERROR, and for "skipped because the rule has no
  /// semanticIntent" alike - the queue is defined as `semantic_resolved_at IS
  /// NULL`, so this column (not a status) is what drains it. NULL = still
  /// pending. Never cleared once set (no automatic re-judging; use the
  /// semantic:once CLI with --rejudge for a deliberate re-run).
  semanticResolvedAt DateTime? @map("semantic_resolved_at") @db.Timestamptz(6)

  /// Optimistic claim lease: when a judge worker picked this row up. Combined
  /// with semanticAttempts to let a crashed worker's claims expire (see
  /// SemanticJudgeStore.claimBatch).
  semanticClaimedAt DateTime? @map("semantic_claimed_at") @db.Timestamptz(6)

  /// Number of judge attempts spent on this row, incremented at claim time.
  /// Bounded by config so a poison row cannot consume model calls forever.
  semanticAttempts Int @default(0) @map("semantic_attempts")

  semanticJudgements MonitorMatchSemantic[]

  /// Idempotency guard: the same rule hitting the same keyword/field on the
  /// same report version of the same record must not be recorded twice.
  @@unique([monitorRecordId, ruleId, matchedField, keyword, reportVersion], name: "uq_monitor_match_dedup")
  @@index([monitorRecordId])
  @@index([ruleId])
  @@index([level])
  @@index([matchedAt])
  /// Effective-hit reads (workbench list/detail, keyword filter, push summary)
  /// all filter on semantic_filtered = false, so it leads this composite.
  @@index([monitorRecordId, semanticFiltered])
  @@map("monitor_match")
}

// ---------------------------------------------------------------------------
// monitor_match_semantic - AI judgement audit trail (issue #87, append-only)
// ---------------------------------------------------------------------------

/// One AI semantic judge ATTEMPT against one MonitorMatch (issue #87).
/// Append-only: rows are never updated or deleted, and one match may have
/// several (a retry after a timeout has its own row). The current verdict is
/// denormalized onto MonitorMatch; this table is the audit trail that explains
/// HOW that verdict was reached.
///
/// PRIVACY (owner decision, 2026-09-25): the raw report text sent to the model
/// is NOT stored here - neither the prompt, nor the context window, nor the
/// model's raw response, nor the `evidence` excerpt verbatim. What is stored is
/// everything needed to (a) prove a check happened and (b) recompute it:
/// content hashes plus the exact offsets into monitor_record's report body
/// (which is already stored, and already gated behind patientDetail rights).
/// `reason` is the model's own explanatory sentence, kept because the issue
/// requires the judgement to be explainable; it is length-bounded and nulled
/// for masked callers. The raw response is discarded once parsed, and `error`
/// records only a machine code + HTTP status - never model output, which could
/// echo the report body back.
///
/// Retention follows its parent match (onDelete: Cascade).
model MonitorMatchSemantic {
  id String @id @default(uuid()) @db.Uuid

  matchId String       @map("match_id") @db.Uuid
  match   MonitorMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  /// Which task produced this row (issue #87 = VALIDATE_MATCH).
  task SemanticTask

  /// Version of the task's prompt/contract, from PROMPT_VERSION in
  /// packages/ai-semantic. Bumped whenever the prompt or output schema changes,
  /// so an old judgement is always attributable to the exact contract that
  /// produced it.
  taskVersion String @map("task_version") @db.VarChar(50)

  /// Whether the CALL succeeded - independent of what it concluded.
  outcome SemanticJudgeOutcome

  // --- Raw model verdict (NULL when outcome = ERROR) ----------------------

  /// The model's semantic status for the hit's context. NOT a monitor level.
  semanticStatus SemanticStatus? @map("semantic_status")

  /// The model's `matched` boolean (false = the hit's context does not express
  /// what the rule watches for). Recorded for audit; the disposition matrix
  /// reads semanticStatus/confidence, not this flag.
  matched Boolean?

  confidence SemanticConfidence?

  /// Model-generated explanation of the verdict. Bounded (300 chars) and
  /// treated as report-adjacent free text: masked for callers without
  /// patientDetail rights, and never logged.
  reason String? @db.VarChar(300)

  /// Whether the model read the rule's semanticIntent as excluding a mere
  /// past history. The disposition matrix requires this to be true before a
  /// HISTORY verdict may filter (issue #87 §7) - the model interprets the
  /// doctor's natural-language intent, the CODE decides the outcome.
  intentExcludesHistory Boolean? @map("intent_excludes_history")

  // --- Evidence: verified in memory, never stored verbatim ----------------

  /// sha256 (hex) of the evidence string the model returned, AFTER it was
  /// verified to be locatable in the exact context sent to the model. NULL when
  /// the model returned no evidence, or when verification failed (in which case
  /// the judge fails open - see decisionReason).
  evidenceHash String? @map("evidence_hash") @db.VarChar(64)

  /// Absolute start offset of the evidence inside the SAME field text as the
  /// match (inclusive, UTF-16 code units). Lets an auditor recompute the
  /// excerpt from monitor_record without this table storing it.
  evidenceStart Int? @map("evidence_start")

  /// Exclusive end offset of the evidence (see evidenceStart).
  evidenceEnd Int? @map("evidence_end")

  // --- Provenance ---------------------------------------------------------

  /// Model identifier as configured (e.g. the gateway's model name).
  model String @db.VarChar(100)

  /// Model version/revision as reported by the gateway, when it reports one.
  modelVersion String? @map("model_version") @db.VarChar(100)

  /// sha256 (hex) of the canonical JSON of the exact task input sent to the
  /// model (rule snapshot + matched text/field + context). Two judgements with
  /// the same inputHash were made from byte-identical inputs, whatever the
  /// model then answered - this is what makes "which input produced this
  /// verdict" answerable without storing the input.
  inputHash String @map("input_hash") @db.VarChar(64)

  /// sha256 (hex) of the context window alone (a sub-hash of inputHash), so an
  /// auditor can reconstruct and check just the excerpt.
  contextHash String @map("context_hash") @db.VarChar(64)

  /// Offsets of the context window inside the field text identified by the
  /// match's matchedField (inclusive start / exclusive end). Reconstructing
  /// monitor_record's text over this range reproduces exactly what the model
  /// was shown.
  contextStart Int @map("context_start")

  contextEnd Int @map("context_end")

  /// Wall-clock duration of the model call, ms. NULL when no call was made
  /// (validation failed before dispatch).
  latencyMs Int? @map("latency_ms")

  /// Machine-readable failure code: TIMEOUT | NETWORK | HTTP_<status> |
  /// INVALID_JSON | SCHEMA_INVALID | UNKNOWN_ENUM | EVIDENCE_UNVERIFIED |
  /// MODEL_ERROR | EMPTY_CONTEXT. NEVER free-form model output or report text.
  error String? @db.VarChar(255)

  // --- The deterministic decision this attempt resulted in ----------------

  /// Whether this attempt filtered the hit. Mirrors the value written to
  /// monitor_match.semanticFiltered by the same transaction.
  filtered Boolean @default(false)

  /// Machine-readable reason for the decision: one of the
  /// SemanticDecisionReason values in packages/ai-semantic (e.g.
  /// NEGATED_HIGH_CONFIDENCE, PRESENT_KEEP, EVIDENCE_UNVERIFIED_KEEP,
  /// MODEL_ERROR_KEEP). This is why "kept" rows are kept.
  decisionReason String @map("decision_reason") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([matchId, createdAt])
  @@index([outcome])
  @@index([decisionReason])
  @@map("monitor_match_semantic")
}

// ---------------------------------------------------------------------------
// sync_job_log - PACS/RIS sync run bookkeeping (cursor, counts, errors)
// ---------------------------------------------------------------------------

/// One run of the (out-of-scope, issue #6) PACS/RIS sync job. Tracks the
/// cursor/window it covered and outcome counts, so sync can resume/retry
/// safely and operators can audit sync health. Contains no patient data.
model SyncJobLog {
  id String @id @default(uuid()) @db.Uuid

  /// Logical job name, e.g. "pacs-ris-incremental-sync", for filtering when
  /// multiple sync jobs exist.
  jobName String @map("job_name") @db.VarChar(100)

  /// Opaque resume cursor (e.g. last-seen source updatedAt or sequence id)
  /// this run started from. Format owned by the sync job implementation.
  cursorStart String? @map("cursor_start") @db.VarChar(255)

  /// Opaque resume cursor this run ended at / left for the next run.
  cursorEnd String? @map("cursor_end") @db.VarChar(255)

  /// Start of the source time window this run queried (if window-based).
  windowStart DateTime? @map("window_start") @db.Timestamptz(6)

  /// End of the source time window this run queried (if window-based).
  windowEnd DateTime? @map("window_end") @db.Timestamptz(6)

  status SyncJobStatus @default(RUNNING)

  /// Number of source records read/considered in this run.
  readCount Int @default(0) @map("read_count")

  /// Number of records successfully upserted (MonitorRecord created or
  /// updated) in this run.
  successCount Int @default(0) @map("success_count")

  /// Number of records that failed to process in this run.
  failureCount Int @default(0) @map("failure_count")

  /// Short error summary for the run (e.g. first/representative error).
  /// Must never contain patient data - source identifiers only.
  errorSummary String? @map("error_summary") @db.Text

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([jobName, startedAt])
  @@index([status])
  @@map("sync_job_log")
}

// ---------------------------------------------------------------------------
// notification_channel - WeCom (企业微信) group-robot webhook targets
// (issue #52/#53)
// ---------------------------------------------------------------------------

/// One configured push destination: a WeCom group-robot webhook URL. See
/// docs/notification-design.md §3/§5 for the full design rationale. Unlike
/// MonitorRule, this is NOT versioned - a webhook URL edit does not need a
/// historical trail of "which version sent which past message", because the
/// channel only describes *where* to push, not report content. Soft-disable
/// only (isEnabled), same pattern as MonitorRule, so a disabled channel can
/// be re-enabled without re-entering the secret.
///
/// SENSITIVE: webhookUrl is the FIRST reversible secret this schema stores
/// (app_user.passwordHash is a one-way Argon2id hash; JWT_SECRET/
/// PACS_HTTP_SERVICE_TOKEN are env vars, never persisted). It is stored
/// ciphertext-only via NotificationSecretCipher (AES-256-GCM, key from
/// NOTIFICATION_SECRET_KEY env var - see apps/api/src/config). The API layer
/// (issue #54) must never return plaintext in any response; only a masked
/// preview is returned for display.
model NotificationChannel {
  id String @id @default(uuid()) @db.Uuid

  /// Human-readable label shown in the config UI, e.g. "内镜中心红色关注群".
  /// Not required to be unique - see docs/notification-design.md §9 open
  /// question; duplicates are allowed at the schema level.
  name String @db.VarChar(100)

  /// AES-256-GCM ciphertext of the WeCom webhook URL, formatted as
  /// "<base64 iv>:<base64 authTag>:<base64 ciphertext>" by
  /// NotificationSecretCipher. Never decrypted for API responses - only for
  /// the outbound HTTP call at send time. See data-dictionary.md (HIGH).
  webhookUrlCiphertext String @map("webhook_url_ciphertext") @db.Text

  /// Soft enable/disable switch. Disabled channels are excluded as
  /// test-send targets but the row (and its audit history) is retained.
  isEnabled Boolean @default(true) @map("is_enabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Operator account (external identity) who created this channel. Not a
  /// FK, same rationale as MonitorRule.createdBy.
  createdBy String @map("created_by") @db.VarChar(100)

  /// Operator account who last modified this channel.
  updatedBy String @map("updated_by") @db.VarChar(100)

  /// Reverse relations for notification push rules (issue: push rules).
  ruleChannels   NotificationRuleChannel[]
  pushDeliveries PushDelivery[]

  @@index([isEnabled])
  @@map("notification_channel")
}

// ---------------------------------------------------------------------------
// notification_template - push content templates (text/news) (issue #52/#53)
// ---------------------------------------------------------------------------

/// One reusable push content template. Rendering (placeholder substitution,
/// e.g. {{redCount}}) happens at send time (issue #54) by reusing the same
/// aggregation logic as GET /api/monitor/summary - this table stores only
/// the template text with placeholders in it, never a rendered/sent message
/// body, to avoid duplicating patient-derived data at rest. See
/// docs/notification-design.md §4.
model NotificationTemplate {
  id String @id @default(uuid()) @db.Uuid

  /// Human-readable label shown in the config UI, e.g. "红色关注日报".
  name String @db.VarChar(100)

  /// Which WeCom webhook message shape this renders to. See
  /// NotificationMsgType doc comment for the TEXT/NEWS -> WeCom mapping.
  msgType NotificationMsgType @map("msg_type")

  /// Title template, used only when msgType = NEWS (WeCom news article
  /// title). May contain {{placeholder}} tokens from the fixed variable
  /// dictionary (issue #54's GET /api/notification-templates/variables).
  titleTemplate String? @map("title_template") @db.VarChar(200)

  /// Body template: full markdown-ish text when msgType = TEXT, or the
  /// article summary/description when msgType = NEWS. May contain
  /// {{placeholder}} tokens.
  contentTemplate String @map("content_template") @db.Text

  /// Static cover image URL for msgType = NEWS. V1 has no dynamic/
  /// auto-generated cover image (see docs/notification-design.md §2/§9) -
  /// this is always a fixed URL the operator supplies (e.g. a hospital/
  /// department logo), never rendered per-send.
  coverImageUrl String? @map("cover_image_url") @db.Text

  /// Click-through URL for msgType = NEWS. Currently points at an address
  /// that may not be reachable from WeCom clients until the hospital
  /// intranet <-> WeCom network path is resolved (see docs/
  /// notification-design.md §1) - stored as-is regardless, display-only
  /// concern for the sender at send time.
  linkUrl String? @map("link_url") @db.Text

  /// Soft enable/disable switch. Disabled templates are excluded as
  /// test-send options but the row is retained.
  isEnabled Boolean @default(true) @map("is_enabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Operator account (external identity) who created this template.
  createdBy String @map("created_by") @db.VarChar(100)

  /// Operator account who last modified this template.
  updatedBy String @map("updated_by") @db.VarChar(100)

  /// Reverse relation for notification push rules (issue: push rules).
  rules NotificationRule[]

  @@index([isEnabled])
  @@index([msgType])
  @@map("notification_template")
}

// ---------------------------------------------------------------------------
// notification_rule / notification_rule_channel - push scheduling rules
// ---------------------------------------------------------------------------

/// A push scheduling rule (issue: push rules): "on <cron> (Asia/Shanghai),
/// send the current-day summary built from <template> to every channel in
/// <channels>." A rule is a pure configuration of WHEN + WHAT + WHERE; the
/// run itself (summary snapshot, rendering, per-channel delivery, push_log)
/// is executed by the shared @epgs/notification-push package from both
/// apps/worker (SCHEDULED tick) and apps/api (MANUAL "run now").
///
/// The cron expression is evaluated against Asia/Shanghai explicitly (never
/// the process TZ). See docs/notification-design.md for the trigger model.
model NotificationRule {
  id String @id @default(uuid()) @db.Uuid

  /// Human-readable rule name shown in the config UI, e.g. "每日 9 点关注摘要".
  name String @db.VarChar(100)

  /// 5-field cron expression (minute-hour-day-month-dow), evaluated in
  /// Asia/Shanghai. Validated with the shared package's
  /// isValidCronExpression on write.
  cron String @db.VarChar(100)

  /// Which template produces the message body for every channel in this rule.
  templateId String               @map("template_id") @db.Uuid
  template   NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  /// Soft enable/disable switch. Disabled rules are skipped by the worker
  /// tick but kept (and still manually runnable? No - see the run endpoint).
  isEnabled Boolean @default(true) @map("is_enabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Operator account (external identity) who created this rule. Not a FK,
  /// same rationale as MonitorRule.createdBy.
  createdBy String @map("created_by") @db.VarChar(100)

  /// Operator account who last modified this rule.
  updatedBy String @map("updated_by") @db.VarChar(100)

  ruleChannels NotificationRuleChannel[]
  pushLogs     PushLog[]

  @@index([isEnabled])
  @@index([templateId])
  @@map("notification_rule")
}

/// Join table between NotificationRule and NotificationChannel (M:N).
model NotificationRuleChannel {
  id String @id @default(uuid()) @db.Uuid

  ruleId String           @map("rule_id") @db.Uuid
  rule   NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  channelId String              @map("channel_id") @db.Uuid
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([ruleId, channelId], name: "uq_notification_rule_channel_pair")
  @@index([channelId])
  @@map("notification_rule_channel")
}

// ---------------------------------------------------------------------------
// push_log / push_delivery - audit trail of every rule run
// ---------------------------------------------------------------------------

/// One execution of a NotificationRule against a specific calendar window
/// (`windowDate`, a Shanghai YYYY-MM-DD). A run fans out to one
/// PushDelivery per rule channel. For SCHEDULED runs a rule may only run
/// once per (rule, windowDate) - enforced by BOTH an application-layer guard
/// and the partial unique index `uq_push_log_scheduled_dedup` created in
/// migration add_notification_push_rules (Prisma `@@unique` cannot express a
/// WHERE-clause partial index). NOTE: that index is hand-written in the
/// migration and NOT expressible in this schema - if `prisma migrate dev`
/// ever proposes dropping it, re-apply it by hand (see migration header).
///
/// No audit_log row is written for SCHEDULED runs (no human operator); this
/// table IS their audit trail. Only the MANUAL "run now" also writes an
/// audit_log entry (AuditAction.NOTIFICATION_RULE_RUN).
model PushLog {
  id String @id @default(uuid()) @db.Uuid

  ruleId String           @map("rule_id") @db.Uuid
  rule   NotificationRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  /// Shanghai date (YYYY-MM-DD) of the summary window this run pushed.
  /// Equal to the run's report date for both SCHEDULED and MANUAL runs.
  windowDate String @map("window_date") @db.VarChar(10)

  trigger NotificationPushTrigger

  /// Aggregate status; written by the executor AFTER all deliveries settle
  /// (initially null while the run is in flight).
  status NotificationPushStatus?

  /// Free-text summary when the run ended FAILED/PARTIAL (e.g. the template
  /// or a channel no longer exists). Never contains patient data or URLs.
  errorSummary String? @map("error_summary") @db.Text

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  deliveries PushDelivery[]
  alertLinks AlertLink[]

  @@index([ruleId, startedAt])
  @@index([trigger])
  @@map("push_log")
}

/// One channel's delivery outcome inside a PushLog run.
model PushDelivery {
  id String @id @default(uuid()) @db.Uuid

  pushLogId String  @map("push_log_id") @db.Uuid
  pushLog   PushLog @relation(fields: [pushLogId], references: [id], onDelete: Cascade)

  channelId String              @map("channel_id") @db.Uuid
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)

  status NotificationPushDeliveryStatus

  /// WeCom `errcode` when the delivery failed at the WeCom layer (0 for
  /// non-WeCom failures like a disabled channel). Null on success.
  wecomErrCode Int? @map("wecom_err_code")

  /// WeCom `errmsg` (or a short reason) when the delivery failed. Never the
  /// webhook URL.
  wecomErrMsg String? @map("wecom_err_msg") @db.VarChar(255)

  /// UTC instant the message was handed to the WeCom webhook. Null when the
  /// delivery failed before any outbound call.
  sentAt DateTime? @map("sent_at") @db.Timestamptz(6)

  @@index([pushLogId])
  @@index([channelId])
  @@map("push_delivery")
}

// ---------------------------------------------------------------------------
// push assistant - the right-corner "推送助理" component's backing data
// (issue #70). The worker is a headless process behind the 网闸: the browser
// can only reach the api, and the api cannot probe the worker process, so
// liveness MUST go through the DB. The worker writes a heartbeat row every
// ~30s; the api judges 在线/失联 by its freshness. The worker also appends
// activity events (sync done / keyword hit / push done) the panel replays.
//
// PRIVACY (notification-design §7): assistant_event.payload carries only
// counts, keyword text, rule names, statuses and durations - never patient
// names, report bodies, or webhook URLs.
// ---------------------------------------------------------------------------

/// Single-row heartbeat table (id is a fixed sentinel). The worker's
/// dedicated heartbeat loop upserts this every ASSISTANT_HEARTBEAT_SECONDS
/// (default 30s); the api reads lastSeenAt and flags 失联 when it is older
/// than ASSISTANT_STALE_SECONDS (default 90s = 3× the write cadence, so one
/// dropped tick is tolerated).
model AssistantHeartbeat {
  /// Fixed sentinel - there is only ever one row ("singleton").
  id String @id @default("singleton")

  /// UTC instant of the worker's most recent heartbeat write. Freshness of
  /// this value is the sole 在线/失联 signal.
  lastSeenAt DateTime @map("last_seen_at") @db.Timestamptz(6)

  /// Earliest next fire across all ENABLED push rules, recomputed each tick
  /// via the shared package's earliestNextTriggerAt (Asia/Shanghai). Null
  /// when no rule is enabled -> the assistant shows "未排程".
  nextTriggerAt DateTime? @map("next_trigger_at") @db.Timestamptz(6)

  /// UTC instant the current worker process started. Used for the panel's
  /// "连续运行 N 天" - process-level (owner decision §5): a worker restart
  /// resets this, we do not persist a cross-restart running total.
  runningSince DateTime @map("running_since") @db.Timestamptz(6)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("assistant_heartbeat")
}

/// What an AssistantEvent records. Mirrored as AssistantEventTypeDto.
///
/// NOTE: no per-sync event type. Sync runs every few minutes; a "已同步 N 份"
/// row per run would flood the short feed and bury the hits/pushes that
/// matter. Sync progress is surfaced as STATE on the status payload
/// (todaySyncCount / lastSyncAt), assembled by the api from sync_job_log.
enum AssistantEventType {
  /// A monitor_match row was newly created for a keyword at a level.
  KEYWORD_HIT
  /// A push rule run finished (SCHEDULED or MANUAL).
  PUSH_DONE
}

/// Activity-feed event, appended by the worker as it works. The panel shows
/// the most recent 4; a background sweep in the heartbeat loop deletes rows
/// older than 7 days (owner decision §5).
model AssistantEvent {
  id String @id @default(uuid()) @db.Uuid

  type AssistantEventType

  /// UTC instant the event occurred (worker clock).
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  /// Structured, privacy-safe facts behind the event, shape keyed by `type`:
  ///   KEYWORD_HIT  { keyword: string, level: MonitorLevel, examItem: string | null }
  ///   PUSH_DONE    { ruleName, status, groupCount, elapsedMs,
  ///                  stages: [{ name, elapsedMs }] }
  /// NEVER patient names, report text, or webhook URLs.
  payload Json

  @@index([occurredAt])
  @@map("assistant_event")
}

// ---------------------------------------------------------------------------
// alert_link - per-level "点击查看患者列表" links appended to a push (issue #72)
// ---------------------------------------------------------------------------

/// One alert link issued for a push run (issue #72): a FROZEN snapshot of the
/// monitor_record ids that sat at `level` inside the run's summary window,
/// reachable for `expiresAt - createdAt` (24h by default) through an opaque
/// token that is NEVER stored - only its SHA-256 hex (`tokenHash`). The token
/// is the credential: AlertLinkGuard resolves it to this row and narrows every
/// read to `recordIds`; no epgs_session is ever issued from a link. Membership
/// is frozen on purpose (user decision): later level changes or new records
/// never alter what a link shows. `openCount`/`lastOpenedAt` are the only
/// access trace (no audit_log row: there is no AppRole actor). Holds NO
/// patient data - ids only. See docs/auth.md "预警链接受限凭证".
model AlertLink {
  id String @id @default(uuid()) @db.Uuid

  /// SHA-256 hex of the opaque token (64 chars) - the unique lookup key.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  /// Which level's list this link opens (UNCLASSIFIED never gets a link).
  level MonitorLevel

  /// Shanghai date (YYYY-MM-DD) of the summary window the snapshot covers.
  windowDate String @map("window_date") @db.VarChar(10)

  /// The push_log run this link was issued for. SetNull so a (currently
  /// never-performed) log deletion cannot fail on this FK.
  pushLogId String?  @map("push_log_id") @db.Uuid
  pushLog   PushLog? @relation(fields: [pushLogId], references: [id], onDelete: SetNull)

  /// Frozen monitor_record ids (the snapshot). Deliberately NOT an FK: a
  /// record removed later simply drops out of the list at read time.
  recordIds String[] @map("record_ids") @db.Uuid

  /// Times the link was opened (GET /api/alert-links/me) + the last instant.
  openCount    Int       @default(0) @map("open_count")
  lastOpenedAt DateTime? @map("last_opened_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@index([pushLogId])
  @@map("alert_link")
}
