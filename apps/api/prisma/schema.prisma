// EPGS Prisma schema.
//
// Monitoring business data model for issue #3. Decoupled from PACS/RIS:
// this schema only stores what EPGS itself needs to keep monitoring
// results alive after the browser closes (rules, matches, current
// highest level, sync job bookkeeping, and an append-only disposition
// timeline). It does NOT store or duplicate PACS/RIS image data, and it
// does NOT implement the keyword-matching algorithm (issue #5) or any
// HTTP API (issue #4/#7/#8) - those consume this schema via Prisma
// Client in later issues.
//
// Field-level meaning, sensitivity classification and retention guidance
// live in /docs/data-dictionary.md - read that alongside this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Attention level assigned to a monitor_record / monitor_match. Fixed set
/// per issue #3 acceptance criteria - do not add values without a migration
/// review, since downstream UI color-codes on this exact enum.
enum MonitorLevel {
  RED
  YELLOW
  GREEN
  UNCLASSIFIED
}

/// Lifecycle status of the closed-loop disposition process for a
/// monitor_record. Derived (denormalized) from the latest monitor_action
/// in the append-only timeline; see monitor_record.handlingStatus doc.
enum HandlingStatus {
  PENDING
  REPORTED
  ACKNOWLEDGED
  RESOLVED
  FALSE_POSITIVE
}

/// Which field the keyword match (or rule) applies to. Kept intentionally
/// generic/coarse - issue #5 owns the actual matching algorithm and may
/// interpret these values more granularly at runtime.
enum MatchField {
  FINDINGS
  IMPRESSION
  REPORT_TEXT
  STUDY_DESCRIPTION
  OTHER
}

/// How a monitor_rule keyword is matched against report text.
enum MatchMode {
  EXACT
  CONTAINS
  REGEX
}

/// Upstream report review/finalization status snapshotted from PACS/RIS at
/// sync time (not EPGS's own disposition status - see HandlingStatus).
enum ReportStatus {
  PRELIMINARY
  FINAL
  AMENDED
  UNKNOWN
}

/// Action type recorded in the append-only monitor_action timeline.
enum ActionType {
  REPORTED
  ACKNOWLEDGED
  RESOLVED
  MARKED_FALSE_POSITIVE
  REOPENED
}

/// Outcome status of one sync_job_log run.
enum SyncJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

// ---------------------------------------------------------------------------
// monitor_rule - keyword rule definitions (versioned, soft-disable only)
// ---------------------------------------------------------------------------

/// A single keyword rule used by the (out-of-scope, issue #5) matching
/// engine to classify report text into a MonitorLevel. Rules are versioned
/// and soft-disabled (isEnabled) rather than deleted, so historical
/// monitor_match rows keep a stable, auditable reference to the exact rule
/// version that produced them.
model MonitorRule {
  id String @id @default(uuid()) @db.Uuid

  /// The keyword or phrase to match. Combined with matchMode to decide how.
  keyword String @db.VarChar(255)

  /// Attention level this rule assigns when it matches.
  level MonitorLevel

  /// Which report field(s) this rule is evaluated against.
  matchField MatchField @map("match_field")

  /// How the keyword is compared against report text.
  matchMode MatchMode @default(CONTAINS) @map("match_mode")

  /// Optional grouping label, e.g. department or tumor-site category, for
  /// workbench filtering and rule-set curation. Free text, not an FK.
  category String? @db.VarChar(100)

  /// Soft enable/disable switch. Disabled rules are excluded from new
  /// matching runs but historical monitor_match rows referencing this rule
  /// are never deleted or reassigned.
  isEnabled Boolean @default(true) @map("is_enabled")

  /// Monotonically increasing version for this logical rule. A rule edit
  /// that changes matching semantics (keyword/level/matchField/matchMode)
  /// should be modeled as a new MonitorRule row with version = previous + 1
  /// and the same ruleGroupId, so existing monitor_match rows keep
  /// pointing at the exact version that matched. See data dictionary.
  version Int @default(1)

  /// Stable identifier shared by all versions of the "same" logical rule.
  /// Defaults to this row's own id when a rule is first created (i.e. the
  /// first version is its own group anchor).
  ruleGroupId String @map("rule_group_id") @db.Uuid

  /// Free-text rationale / clinical justification, for audit review.
  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Operator account (external identity, e.g. HIS/OA user id) who created
  /// this rule version. Not a FK - user/auth store is owned by a later
  /// issue; kept as an opaque string to avoid a premature cross-schema
  /// dependency.
  createdBy String @map("created_by") @db.VarChar(100)

  /// Operator account who last modified this rule version.
  updatedBy String @map("updated_by") @db.VarChar(100)

  matches MonitorMatch[]

  @@index([level, isEnabled])
  @@index([ruleGroupId])
  @@index([category])
  @@map("monitor_rule")
}

// ---------------------------------------------------------------------------
// monitor_record - one row per monitored study/report, with current state
// ---------------------------------------------------------------------------

/// One monitored study/report from the source PACS/RIS system, deduplicated
/// on the source's natural key. Holds the CURRENT aggregate state (highest
/// level reached, handling status) while full match evidence lives in
/// monitor_match and full disposition history lives in monitor_action.
///
/// Idempotency: re-syncing the same study/report version must not create a
/// duplicate row - see the @@unique constraint below, which sync jobs
/// (issue #6/#8) must upsert against.
model MonitorRecord {
  id String @id @default(uuid()) @db.Uuid

  // --- Source identity (natural key from PACS/RIS, read-only adapter) ----

  /// Source system's study accession number. Primary half of the natural
  /// key used for idempotent upserts from issue #2's read-only adapter.
  studyAccessionNo String @map("study_accession_no") @db.VarChar(64)

  /// Source system's report identifier. Second half of the natural key -
  /// a study can have zero, one, or (after amendment) multiple reports
  /// over time, each producing its own logical monitor_record.
  reportId String @map("report_id") @db.VarChar(64)

  /// Report version/revision number from the source system (e.g.
  /// incremented on amendment). Used together with sourceUpdatedAt to
  /// detect whether a re-synced report actually changed and needs
  /// re-matching, without creating a duplicate monitor_record.
  reportVersion Int @default(1) @map("report_version")

  /// Last-modified timestamp of the report as reported by the source
  /// system (not EPGS's own updatedAt). Used for idempotency / staleness
  /// checks alongside reportVersion.
  sourceUpdatedAt DateTime @map("source_updated_at") @db.Timestamptz(6)

  // --- Patient / study snapshot (minimized, display + audit only) -------
  // Snapshotted (not FK'd) because PACS/RIS is the system of record and
  // EPGS must keep working even if the source record later changes or the
  // patient is not resolvable. See data dictionary for sensitivity levels
  // and the "minimum necessary for display + audit" rule.

  /// Patient display name snapshot. HIGH sensitivity - see data dictionary.
  patientName String? @map("patient_name") @db.VarChar(100)

  /// Masked/partial patient identifier for display (e.g. last 4 of ID),
  /// never the full national ID. HIGH sensitivity.
  patientIdMasked String? @map("patient_id_masked") @db.VarChar(50)

  /// Inpatient/outpatient number snapshot. HIGH sensitivity.
  inpatientNo String? @map("inpatient_no") @db.VarChar(64)

  /// Ordering/performing department at time of sync. Used for workbench
  /// filtering.
  department String? @db.VarChar(100)

  /// Study modality/description snapshot (e.g. "胃镜", "肠镜"), for display.
  studyDescription String? @map("study_description") @db.VarChar(255)

  /// Timestamp the study/exam was performed, per source system.
  studyTime DateTime? @map("study_time") @db.Timestamptz(6)

  // --- Aggregate monitoring state (denormalized for fast workbench reads) -

  /// Highest MonitorLevel across all current monitor_match rows for this
  /// record. Denormalized/maintained by the matching engine (issue #5) so
  /// the workbench can filter/sort without joining monitor_match.
  currentLevel MonitorLevel @default(UNCLASSIFIED) @map("current_level")

  /// First time any rule matched this record.
  firstMatchedAt DateTime? @map("first_matched_at") @db.Timestamptz(6)

  /// Most recent time any rule matched this record (including re-matches
  /// after a report amendment).
  lastMatchedAt DateTime? @map("last_matched_at") @db.Timestamptz(6)

  /// Upstream report review/finalization status snapshot.
  reportStatus ReportStatus @default(UNKNOWN) @map("report_status")

  /// EPGS's own closed-loop disposition status. Denormalized from the
  /// latest monitor_action row for this record - see monitor_action for
  /// the authoritative append-only history this is derived from.
  handlingStatus HandlingStatus @default(PENDING) @map("handling_status")

  /// Optional cached report body, gated by the retention/encryption policy
  /// described in the data dictionary. NULL unless caching is explicitly
  /// enabled per that policy; not populated or read by this issue.
  reportTextCache String? @map("report_text_cache") @db.Text

  /// Expiry timestamp for reportTextCache, required whenever the cache is
  /// populated (enforced at the application layer, not the DB layer, since
  /// Postgres cannot conditionally-require a column based on another).
  reportTextCacheExpiresAt DateTime? @map("report_text_cache_expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  matches MonitorMatch[]
  actions MonitorAction[]

  /// Idempotency guard: the same source study/report/version must never
  /// produce two rows. Sync jobs upsert on this key.
  @@unique([studyAccessionNo, reportId, reportVersion], name: "uq_monitor_record_source_version")
  @@index([currentLevel])
  @@index([department])
  @@index([reportStatus])
  @@index([handlingStatus])
  @@index([studyTime])
  @@index([lastMatchedAt])
  @@index([studyAccessionNo, reportId])
  @@map("monitor_record")
}

// ---------------------------------------------------------------------------
// monitor_match - full hit evidence (many per record, never overwritten)
// ---------------------------------------------------------------------------

/// One keyword hit: a specific MonitorRule matching a specific
/// MonitorRecord's report text. Multiple matches accumulate per record so
/// the "current highest level" (on MonitorRecord) and "all hit evidence"
/// (here) are both retained, per issue #3 acceptance criteria.
///
/// Idempotency: re-matching the same report version must not duplicate a
/// previously recorded hit - see the @@unique constraint below.
model MonitorMatch {
  id String @id @default(uuid()) @db.Uuid

  monitorRecordId String        @map("monitor_record_id") @db.Uuid
  record          MonitorRecord @relation(fields: [monitorRecordId], references: [id], onDelete: Cascade)

  ruleId String      @map("rule_id") @db.Uuid
  rule   MonitorRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  /// Denormalized copy of the keyword text at match time, kept even if the
  /// rule is later edited/versioned, so this row remains a faithful,
  /// immutable record of what actually matched.
  keyword String @db.VarChar(255)

  /// Denormalized copy of the level assigned at match time.
  level MonitorLevel

  /// Which report field the hit occurred in.
  matchedField MatchField @map("matched_field")

  /// Short surrounding-text snippet for display in the evidence panel.
  /// Deliberately bounded/short (not the full report) - see data
  /// dictionary retention policy for why full report text is a separate,
  /// explicitly-gated cache field on MonitorRecord instead.
  contextSnippet String @map("context_snippet") @db.VarChar(500)

  /// Report version this match was produced against - lets a record with
  /// multiple report versions (amendments) keep each version's matches
  /// distinguishable, and is part of the idempotency key.
  reportVersion Int @map("report_version")

  matchedAt DateTime @default(now()) @map("matched_at") @db.Timestamptz(6)

  /// Idempotency guard: the same rule hitting the same keyword/field on the
  /// same report version of the same record must not be recorded twice.
  @@unique([monitorRecordId, ruleId, matchedField, keyword, reportVersion], name: "uq_monitor_match_dedup")
  @@index([monitorRecordId])
  @@index([ruleId])
  @@index([level])
  @@index([matchedAt])
  @@map("monitor_match")
}

// ---------------------------------------------------------------------------
// monitor_action - append-only closed-loop disposition timeline
// ---------------------------------------------------------------------------

/// One step in the closed-loop disposition timeline for a MonitorRecord:
/// reported / acknowledged / resolved / marked false positive / reopened.
///
/// APPEND-ONLY BY CONTRACT: rows in this table must only ever be INSERTed.
/// No application code (this issue or any future issue, e.g. #8's API)
/// may UPDATE or DELETE a monitor_action row. MonitorRecord.handlingStatus
/// is a denormalized projection that MUST be recomputed by taking the
/// latest monitor_action row for that record - never by mutating history.
/// This is a data-dictionary-documented convention; Prisma/Postgres do not
/// mechanically forbid UPDATE/DELETE (no DB user/trigger lockdown is set
/// up by this issue), so this comment plus /docs/data-dictionary.md is the
/// authoritative constraint for issue #8 and any other consumer.
model MonitorAction {
  id String @id @default(uuid()) @db.Uuid

  monitorRecordId String        @map("monitor_record_id") @db.Uuid
  record          MonitorRecord @relation(fields: [monitorRecordId], references: [id], onDelete: Cascade)

  actionType ActionType @map("action_type")

  /// Operator account (external identity) who performed the action, e.g.
  /// who reported it or who acknowledged it. Opaque string, see MonitorRule
  /// createdBy/updatedBy for the same convention.
  actorId String @map("actor_id") @db.VarChar(100)

  /// For REPORTED actions: the recipient (department contact, clinician,
  /// or role) the finding was reported to. NULL for action types where a
  /// recipient does not apply.
  recipientId String? @map("recipient_id") @db.VarChar(100)

  /// Free-text note (e.g. reason for false-positive, resolution summary).
  note String? @db.Text

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([monitorRecordId, occurredAt])
  @@index([actionType])
  @@index([occurredAt])
  @@map("monitor_action")
}

// ---------------------------------------------------------------------------
// sync_job_log - PACS/RIS sync run bookkeeping (cursor, counts, errors)
// ---------------------------------------------------------------------------

/// One run of the (out-of-scope, issue #6) PACS/RIS sync job. Tracks the
/// cursor/window it covered and outcome counts, so sync can resume/retry
/// safely and operators can audit sync health. Contains no patient data.
model SyncJobLog {
  id String @id @default(uuid()) @db.Uuid

  /// Logical job name, e.g. "pacs-ris-incremental-sync", for filtering when
  /// multiple sync jobs exist.
  jobName String @map("job_name") @db.VarChar(100)

  /// Opaque resume cursor (e.g. last-seen source updatedAt or sequence id)
  /// this run started from. Format owned by the sync job implementation.
  cursorStart String? @map("cursor_start") @db.VarChar(255)

  /// Opaque resume cursor this run ended at / left for the next run.
  cursorEnd String? @map("cursor_end") @db.VarChar(255)

  /// Start of the source time window this run queried (if window-based).
  windowStart DateTime? @map("window_start") @db.Timestamptz(6)

  /// End of the source time window this run queried (if window-based).
  windowEnd DateTime? @map("window_end") @db.Timestamptz(6)

  status SyncJobStatus @default(RUNNING)

  /// Number of source records read/considered in this run.
  readCount Int @default(0) @map("read_count")

  /// Number of records successfully upserted (MonitorRecord created or
  /// updated) in this run.
  successCount Int @default(0) @map("success_count")

  /// Number of records that failed to process in this run.
  failureCount Int @default(0) @map("failure_count")

  /// Short error summary for the run (e.g. first/representative error).
  /// Must never contain patient data - source identifiers only.
  errorSummary String? @map("error_summary") @db.Text

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([jobName, startedAt])
  @@index([status])
  @@map("sync_job_log")
}
