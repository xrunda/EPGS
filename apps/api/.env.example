# apps/api local environment. Copy to apps/api/.env for local dev.
# See root .env.example for the full variable reference/comments.
NODE_ENV=development
PORT=3000
TZ=Asia/Shanghai
LOG_LEVEL=log
DATABASE_URL=postgresql://epgs:epgs@localhost:5432/epgs
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_SECONDS=28800
WEB_ORIGIN=http://localhost:5173

# Controls the `Secure` attribute on the auth session cookie. Defaults to
# NODE_ENV === 'production' when unset. Browsers silently drop `Secure`
# cookies over plain HTTP, so set this to `false` when NODE_ENV=production
# but the deployment is served over plain HTTP (e.g. an internal bastion
# host with no TLS) - otherwise login will appear to succeed and then
# immediately bounce back to the login page on the next request.
# COOKIE_SECURE=false

# Issue #6: used only by GET /api/system/sync-status to judge how stale
# a sync run is (as a multiple of this interval). Should match
# apps/worker's SYNC_INTERVAL_MINUTES - a mismatch only affects health
# classification accuracy, not correctness of the raw data returned.
SYNC_INTERVAL_MINUTES=3

# Issue #53: encryption key for NotificationChannel.webhookUrlCiphertext -
# the first reversible secret this schema stores (a WeCom webhook URL).
# Generate a real random value for any non-local environment, e.g.:
#   openssl rand -base64 32
# Never reuse JWT_SECRET's value here - keep the two independent so
# rotating one does not require rotating the other.
NOTIFICATION_SECRET_KEY=replace-with-at-least-32-random-characters

# Issue #54: display name substituted for the {{hospitalName}} placeholder
# when rendering notification templates (see AppConfig.hospitalName). Defaults
# to 菏泽市中医医院 when unset - only set this if the deployment is a
# different hospital.
# HOSPITAL_NAME=菏泽市中医医院

# Issue #70: how old the worker's assistant_heartbeat row may get (seconds)
# before the push assistant is reported as 失联. Default 90 = 3× the worker's
# ASSISTANT_HEARTBEAT_SECONDS (30). Keep the two operationally in sync; a
# mismatch only shifts how fast 失联 is declared. Optional.
# ASSISTANT_STALE_SECONDS=90

# Issue #72: origin WeCom clients use to open the web app's /alert page. When
# set, push runs append per-level "查看患者列表" cards; unset/empty disables
# them (safe default while the intranet <-> WeCom path is unconfirmed). Must
# equal apps/worker's value. ALERT_LINK_TTL_HOURS = link lifetime (default 24).
# ALERT_LINK_BASE_URL=http://10.0.0.5:5173
ALERT_LINK_TTL_HOURS=24
