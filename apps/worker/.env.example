# apps/worker local environment. Copy to apps/worker/.env for local dev.
# See root .env.example for the full variable reference/comments.
NODE_ENV=development
PORT=3001
TZ=Asia/Shanghai
LOG_LEVEL=log

# Incremental PACS/RIS sync job (issue #6, see src/sync/). Cadence in
# minutes - default 3, must be 1-5 per the issue's acceptance criteria.
SYNC_INTERVAL_MINUTES=3
# Max rows requested from the adapter per fetchReports() page (1-500).
SYNC_PAGE_SIZE=200
# Re-reads the last N minutes on every run in addition to the resume
# cursor, so a source outage or late-arriving update within this window
# is never silently skipped (upserts are idempotent, so re-reading
# already-synced rows is safe). 0-120, default 10.
SYNC_LOOKBACK_MINUTES=10
# Max retry attempts (exponential backoff) for a whole-batch transient
# adapter failure (e.g. HTTP 503/429/network error) before a run is
# marked FAILED without advancing its cursor.
SYNC_MAX_RETRIES=5
SYNC_RETRY_BASE_DELAY_MS=1000

DATABASE_URL=postgresql://epgs:epgs@localhost:5432/epgs

# PACS/RIS read-only adapter (see src/pacs-adapter, docs/pacs-ris-adapter.md).
# 'fixture' = synthetic in-memory data, no real DB needed (default for dev/CI).
# 'sql' = unfinished skeleton (issue #2, no live driver wired to a real DB).
# 'http' = real issue #20 database gateway contract over HTTP (issue #6).
PACS_ADAPTER_MODE=fixture
# Only used when PACS_ADAPTER_MODE=sql. Never commit real values here.
# PACS_DB_HOST=
# PACS_DB_PORT=1433
# PACS_DB_NAME=
# PACS_DB_USER=
# PACS_DB_PASSWORD=

# Only used when PACS_ADAPTER_MODE=http (issue #6, docs/api/pacs-ris-data-api.md).
# No real test-environment Base URL/token exists in this repo - issue #20's
# contract doc states these are provided through a secure channel, never
# committed. Only mock HTTP servers are used in this repo's tests.
# PACS_HTTP_BASE_URL=
# PACS_HTTP_SERVICE_TOKEN=
PACS_HTTP_TIMEOUT_MS=10000
