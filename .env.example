# EPGS environment variable reference.
#
# Copy this file to `.env` at the repo root and fill in real values for
# local development. NEVER commit a real `.env` file - it is gitignored
# on purpose. ALL secrets must come from environment variables only,
# never hardcoded in source. See README.md "Environment variables".
#
# Note: apps/api and apps/worker each read PORT from their own process
# environment. When running them together (see root `pnpm dev`), each
# app's start script sets its own PORT so they don't collide - see
# apps/api/.env.example and apps/worker/.env.example for per-app values.

# ---- Shared across api / worker ------------------------------------------
NODE_ENV=development
TZ=Asia/Shanghai
LOG_LEVEL=log

# PostgreSQL connection string used by apps/api and apps/worker (via Prisma).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Matches docker-compose.yml's local Postgres service by default.
DATABASE_URL=postgresql://epgs:epgs@localhost:5432/epgs

# ---- apps/api --------------------------------------------------------------
PORT=3000

# ---- apps/worker -------------------------------------------------------------
# Worker listens on its own port for internal health checks (not
# publicly exposed). Must differ from apps/api's PORT when run together.
# How often the placeholder sync job logs a "sync tick" (issue #6 will
# replace the placeholder with real PACS/RIS sync logic).
SYNC_INTERVAL_MINUTES=15

# PACS/RIS read-only adapter (issue #2, see apps/worker/src/pacs-adapter
# and docs/pacs-ris-adapter.md). 'fixture' (default) uses synthetic
# in-memory data - safe for local dev and CI without a real database.
# 'sql' targets a real read-only PACS/RIS database (SQL Server assumed;
# see docs for how to adapt to another RDBMS) - not wired to a live
# driver in issue #2. PACS_DB_* are only relevant when mode=sql and must
# never contain real credentials in this file.
PACS_ADAPTER_MODE=fixture
# PACS_DB_HOST=
# PACS_DB_PORT=1433
# PACS_DB_NAME=
# PACS_DB_USER=
# PACS_DB_PASSWORD=

# ---- apps/web ----------------------------------------------------------------
# Vite only exposes vars prefixed with VITE_ to client-side code.
VITE_API_BASE_URL=http://localhost:3000

# ---- Auth placeholders (wired up in issue #13) --------------------------------
# JWT_SECRET=
# SESSION_SECRET=
