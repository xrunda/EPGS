# apps/worker local environment. Copy to apps/worker/.env for local dev.
# See root .env.example for the full variable reference/comments.
NODE_ENV=development
PORT=3001
TZ=Asia/Shanghai
LOG_LEVEL=log

# Incremental PACS/RIS sync job (issue #6, see src/sync/). Cadence in
# minutes - default 3, must be 1-5 per the issue's acceptance criteria.
SYNC_INTERVAL_MINUTES=3
# Max rows requested from the adapter per fetchReports() page (1-500).
SYNC_PAGE_SIZE=200
# Re-reads the last N minutes on every run in addition to the resume
# cursor, so a source outage or late-arriving update within this window
# is never silently skipped (upserts are idempotent, so re-reading
# already-synced rows is safe). 0-120, default 10.
SYNC_LOOKBACK_MINUTES=10
# First-ever run window (minutes before "now"), used only when there is
# no prior SUCCEEDED/PARTIAL sync_job_log row at all. Independent from
# SYNC_LOOKBACK_MINUTES on purpose - a fresh deployment's first sync
# needs to catch up on however much backlog exists at go-live, not just
# the steady-state look-back window. Default 1440 (24h); raise this for
# a larger initial backlog at rollout time.
SYNC_FIRST_RUN_LOOKBACK_MINUTES=1440
# Max retry attempts (exponential backoff) for a whole-batch transient
# adapter failure (e.g. HTTP 503/429/network error) before a run is
# marked FAILED without advancing its cursor.
SYNC_MAX_RETRIES=5
SYNC_RETRY_BASE_DELAY_MS=1000

DATABASE_URL=postgresql://epgs:epgs@localhost:5432/epgs

# PACS/RIS read-only adapter (see src/pacs-adapter, docs/pacs-ris-adapter.md).
# 'csv' = local-only, API-shaped synthetic CSV.
# 'http' = hospital REST gateway; this project never reads the source DB directly.
PACS_ADAPTER_MODE=csv
# Relative to apps/worker when launched through pnpm --filter. The hospital's
# raw export (GB18030 + Chinese headers) must first be converted with
#   pnpm --filter worker run mock:convert
# which writes Doc/moke-data.utf8.csv from Doc/moke-*.csv (issue #42).
PACS_MOCK_CSV_PATH=../../Doc/moke-data.utf8.csv

# Required only when PACS_ADAPTER_MODE=http. Inject real values through the
# hospital secret-management path; never commit them.
# PACS_HTTP_BASE_URL=
# PACS_HTTP_SERVICE_TOKEN=
PACS_HTTP_TIMEOUT_MS=10000

# Required only when PACS_ADAPTER_MODE=soap. Inject real values through the
# hospital secret-management path; never commit them.
# PACS_SOAP_BASE_URL=
# PACS_SOAP_USERNAME=
# PACS_SOAP_PASSWORD=
# PACS_SOAP_KEY_NAME=
PACS_SOAP_TIMEOUT_MS=15000
# Set to true when the SOAP gateway's TLS certificate is self-signed or
# otherwise untrusted (Node's fetch, unlike `curl -k`, rejects it by default
# with an opaque "fetch failed" error). Skips certificate verification for
# this call only - leave unset/false whenever the gateway has a trusted cert.
# PACS_SOAP_TLS_INSECURE=false

# Scheduled push rules (issue: push rules). NOTIFICATION_SECRET_KEY MUST be the
# same value as apps/api's - the worker decrypts NotificationChannel.webhookUrl
# ciphertexts that the api created (shared DB). HOSPITAL_NAME is rendered into
# {{hospitalName}} in push bodies. NOTIFICATION_TICK_SECONDS is the scheduler
# tick cadence (10-300, default 60 - minute-granularity cron needs tick <= 60s).
NOTIFICATION_SECRET_KEY=
HOSPITAL_NAME=菏泽市中医医院
NOTIFICATION_TICK_SECONDS=60

# Push assistant (issue #70). The worker publishes its liveness through a DB
# heartbeat row (the api cannot probe the worker process behind the 网闸).
# ASSISTANT_HEARTBEAT_SECONDS is how often that row is rewritten (10-120,
# default 30 - independent of NOTIFICATION_TICK_SECONDS). The api's own
# ASSISTANT_STALE_SECONDS should be ~3× this. ASSISTANT_EVENT_RETENTION_DAYS
# is how long activity-feed rows are kept before the heartbeat loop sweeps
# them (1-90, default 7). Both optional - defaults are fine for production.
# ASSISTANT_HEARTBEAT_SECONDS=30
# ASSISTANT_EVENT_RETENTION_DAYS=7

# Issue #72: origin WeCom clients use to open the web app's /alert page. The
# worker issues the per-level alert links for scheduled runs, so this MUST
# equal apps/api's value. Unset/empty disables the cards (template message
# only). ALERT_LINK_TTL_HOURS = link lifetime in hours (default 24).
# ALERT_LINK_BASE_URL=http://10.0.0.5:5173
ALERT_LINK_TTL_HOURS=24
