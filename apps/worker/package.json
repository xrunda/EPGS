{
  "name": "@epgs/worker",
  "version": "0.1.0",
  "private": true,
  "description": "EPGS background sync/monitoring worker (NestJS)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "sync:once": "ts-node --transpile-only -r tsconfig-paths/register src/sync/run-once.ts",
    "reclassify:once": "ts-node --transpile-only -r tsconfig-paths/register src/sync/reclassify-once.ts",
    "mock:convert": "ts-node --transpile-only -r tsconfig-paths/register src/pacs-adapter/mock-csv-convert.ts"
  },
  "dependencies": {
    "@epgs/matching-engine": "workspace:*",
    "@epgs/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.6",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/schedule": "^4.1.1",
    "@prisma/client": "^5.22.0",
    "csv-parse": "^5.6.0",
    "joi": "^17.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "undici": "^6.21.0"
  }
}
