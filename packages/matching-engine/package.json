{
  "name": "@epgs/matching-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure, deterministic keyword-matching engine for EPGS monitor rules (issue #5). No DB/HTTP access - consumed by apps/worker (sync-time matching) and apps/api (rule preview).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "bench": "ts-node src/bench/run-benchmark.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
